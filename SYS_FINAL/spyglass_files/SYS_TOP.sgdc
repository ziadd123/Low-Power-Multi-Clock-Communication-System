# ==============================================================================
# SpyGlass Constraints File (SGDC) for SYS_TOP
# Design: SYS_TOP
# Analysis: Linting & Clock Domain Crossing (CDC)
# ==============================================================================

current_design "SYS_TOP"

# ------------------------------------------------------------------------------
# 1. Clock Definitions
# ------------------------------------------------------------------------------
# Primary Master Clocks
clock -name "SYS_TOP.REF_CLK"  -period 20.0     -domain "d_ref"   -edge {0 10.0} 
clock -name "SYS_TOP.UART_CLK" -period 271.267  -domain "d_uart"  -edge {0 135.63}

# Derived / Generated Clocks inside Design
# ALU_CLK from Clock Gating block (driven by REF_CLK)
clock -name "SYS_TOP.U0_CLK_GATE.GATED_CLK" -period 20.0     -domain "d_ref"   -edge {0 10.0}

# RX_CLK and TX_CLK generated by Clock Dividers (driven by UART_CLK)
clock -name "SYS_TOP.U1_ClkDiv.o_div_clk"   -period 271.267  -domain "d_uart"  -edge {0 135.63}
clock -name "SYS_TOP.U0_ClkDiv.o_div_clk"   -period 8680.544  -domain "d_uart"  -edge {0 4340.272}
# ------------------------------------------------------------------------------
# 2. Reset Definitions
# ------------------------------------------------------------------------------
# Asynchronous Active-Low Global Reset
reset -name "SYS_TOP.RST_N" -value 0 -async

# Synchronized Resets (Output of Reset Synchronizers)
reset -name "SYS_TOP.U0_RST_SYNC.sync_rst" -value 0 -async
reset -name "SYS_TOP.U1_RST_SYNC.sync_rst" -value 0 -async

# ------------------------------------------------------------------------------
# 3. Input & Output Port Clock Associations
# ------------------------------------------------------------------------------
# Inputs
abstract_port -ports "UART_RX_IN" -clock "UART_CLK"

# Outputs
abstract_port -ports "UART_TX_O"     -clock "UART_CLK"
abstract_port -ports "parity_error"  -clock "UART_CLK"
abstract_port -ports "framing_error" -clock "UART_CLK"

# ------------------------------------------------------------------------------
# 4. CDC & Synchronizer Structural Recognition
# ------------------------------------------------------------------------------
# Synchronizer modules recognition
sync_cell -name "DATA_SYNC" 

# Quasi-static configuration signals (UART_Config from RegFile to UART/ClkDiv)
# Signals that change rarely during normal operation and don't need double-flop syncs
quasi_static -name "SYS_TOP.UART_Config[*]"
quasi_static -name "SYS_TOP.DIV_RATIO[*]"
quasi_static -name "SYS_TOP.DIV_RATIO_RX[*]"
set_case_analysis -name "SYS_TOP.U0_RegFile.REG2[*]" -value 0
set_case_analysis -name "SYS_TOP.U0_RegFile.REG3[*]" -value 0

# Mark FIFO Gray pointers as gray-encoded to allow safe convergence
cdc_attribute -unrelated {"SYS_TOP.U0_UART_FIFO.u_sync_r2w.sync_reg[*]" "SYS_TOP.U0_ref_sync.sync_reg[0]"}
cdc_attribute -unrelated {"SYS_TOP.U0_UART_FIFO.u_sync_w2r.sync_reg[*]" "SYS_TOP.U0_ref_sync.sync_reg[0]"}






